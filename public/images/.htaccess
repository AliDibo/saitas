# images/ – sadece medya dosyaları. Script çalıştırma ve dizin listeleme kapalı.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py .asp .aspx .jsp .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps
<FilesMatch "\.(?i:php\d?|phtml|phps|cgi|pl|py|asp|aspx|jsp|sh|html?|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  # SVG'ler doğrudan açılırsa içindeki script çalışmasın
  <FilesMatch "\.svg$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox"
  </FilesMatch>
</IfModule>
